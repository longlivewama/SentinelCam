# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

# --- Environment ---
ENVIRONMENT=development

# --- Database ---
# Must be a PostgreSQL connection string (psycopg2-binary driver).
DATABASE_URL=postgresql://sentinelcam:sentinelcam@localhost:5432/sentinelcam

# --- Auth / JWT ---
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Lifetime of the short-lived, single-resource token the media endpoints accept
# in a query string (a browser cannot put a header on `<video src>`). Long enough
# that opening a page and pressing play a few minutes later still works; short
# enough that one recovered from a log is almost always already dead. It never
# authenticates anything but the one clip, upload or camera it names.
MEDIA_TOKEN_EXPIRE_SECONDS=300

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (used to build links in emails, e.g. password reset) ---
FRONTEND_URL=http://localhost:5173

# --- Notifications ---
# Comma-separated list of enabled channels. "email" works out of the box;
# "sms"/"whatsapp" are architectural stubs (see
# app/services/notifications/sms_notifier.py) until a real provider (e.g.
# Twilio) is wired in.
NOTIFICATION_CHANNELS=email

# --- SMTP / alert + password-reset email (app/services/notifications/email_notifier.py) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM=alerts@sentinelcam.local
# Comma-separated list of recipient email addresses for alert notifications.
ALERT_RECIPIENTS=security-team@example.com,ops@example.com

# --- Storage (defaults resolve to backend/storage/{recordings,snapshots,uploads} if left unset) ---
RECORDINGS_DIR=./storage/recordings
SNAPSHOTS_DIR=./storage/snapshots
UPLOADS_DIR=./storage/uploads

# --- Video upload / analysis ---
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
# How many frames to skip between processed frames when analyzing an
# uploaded video (independent of live-camera DETECTION_FRAME_STRIDE).
VIDEO_ANALYSIS_FRAME_STRIDE=5

# --- Models ---
YOLO_POSE_MODEL=yolov8n-pose.pt
YOLO_MODEL=yolov8n.pt
MODEL_DEVICE=cpu
# Optional hook for a future trained temporal action-recognition model
# (CNN+LSTM/3D-CNN on RWF-2000) to replace the MVP violence heuristic.
# Leave empty to keep using the heuristic.
VIOLENCE_MODEL_PATH=
# Optional corroborating fall classifier trained under ml/ (see
# ml/README.md for the full pipeline + honest evaluation caveats before
# enabling this in anything resembling production). Leave empty to run
# the pose heuristic alone (default). To enable:
#   FALL_CLASSIFIER_MODEL_PATH=../ml/exported/fall_classifier_v1.onnx
FALL_CLASSIFIER_MODEL_PATH=

# --- Streaming / recording ---
STREAM_FPS=30
ROLLING_BUFFER_FRAMES=90
POST_EVENT_SECONDS=3
# Run the AI detection pipeline every Nth captured frame (tunable - lower
# is more responsive but more CPU-expensive).
DETECTION_FRAME_STRIDE=3
