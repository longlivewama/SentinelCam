# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

# --- Database ---
# Must be a PostgreSQL connection string (psycopg2-binary driver).
DATABASE_URL=postgresql://sentinelcam:sentinelcam@localhost:5432/sentinelcam

# --- Auth / JWT ---
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- SMTP / alert email (used by app/services/email_service.py) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM=alerts@sentinelcam.local
# Comma-separated list of recipient email addresses for alert notifications.
ALERT_RECIPIENTS=security-team@example.com,ops@example.com

# --- Storage (defaults resolve to backend/storage/{recordings,snapshots} if left unset) ---
RECORDINGS_DIR=./storage/recordings
SNAPSHOTS_DIR=./storage/snapshots

# --- Models ---
YOLO_POSE_MODEL=yolov8n-pose.pt
YOLO_MODEL=yolov8n.pt
MODEL_DEVICE=cpu
# Optional hook for a future trained temporal action-recognition model
# (CNN+LSTM/3D-CNN on RWF-2000) to replace the MVP violence heuristic.
# Leave empty to keep using the heuristic.
VIOLENCE_MODEL_PATH=

# --- Streaming / recording ---
STREAM_FPS=30
ROLLING_BUFFER_FRAMES=90
POST_EVENT_SECONDS=3
# Run the AI detection pipeline every Nth captured frame (tunable - lower
# is more responsive but more CPU-expensive).
DETECTION_FRAME_STRIDE=3
