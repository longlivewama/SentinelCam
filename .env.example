# Optional overrides for `docker compose up`. Copy to `.env` in the repo
# root if you want to change any defaults - docker compose reads this
# automatically. Every one of these has a sane default baked into
# docker-compose.yml, so this file is entirely optional for a quick
# local run.

POSTGRES_PASSWORD=sentinelcam
POSTGRES_PORT=5432

# Generate a real one for anything beyond local testing:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

ALERT_RECIPIENTS=ops@example.com

# --- Fall detection ---
# The trained detector is mounted read-only into the backend container at
# /models by docker-compose.yml (from ml/exported/), so this default works
# out of the box. FALL_DETECTION_MODE:
#   auto      - trained model when it loads, pose heuristic otherwise (default)
#   model     - trained model only; no fall events if it cannot be loaded
#   heuristic - pose heuristic only
#   hybrid    - both, reporting the union (higher recall, more false positives)
FALL_DETECTOR_MODEL_PATH=/models/fall_detector_v1.pt
FALL_DETECTION_MODE=auto

# How many uploaded videos may be analysed at once. Each one decodes a
# video and runs inference on its own thread; the rest queue.
MAX_CONCURRENT_VIDEO_ANALYSES=2

# Backend container resource ceiling. Inference is CPU-bound and video
# decoding is memory-hungry; size these to the host and camera count.
BACKEND_CPU_LIMIT=4.0
BACKEND_MEMORY_LIMIT=4g

# Per-IP rate limits on the sensitive auth endpoints. These defaults are
# the intended production values - relax them only in a test environment
# (the e2e suite does this for its own stack, see e2e/global-setup.js).
AUTH_SIGNUP_MAX_REQUESTS=5
AUTH_SIGNUP_WINDOW_SECONDS=60
AUTH_LOGIN_MAX_REQUESTS=10
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_FORGOT_PASSWORD_MAX_REQUESTS=5
AUTH_FORGOT_PASSWORD_WINDOW_SECONDS=300
AUTH_RESET_PASSWORD_MAX_REQUESTS=10
AUTH_RESET_PASSWORD_WINDOW_SECONDS=60

BACKEND_PORT=8000
FRONTEND_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
