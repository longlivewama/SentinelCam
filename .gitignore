# Python
__pycache__/
*.pyc
*.pyo
backend/venv/
backend/.venv/
backend/.env
backend/storage/recordings/*
!backend/storage/recordings/.gitkeep
backend/storage/snapshots/*
!backend/storage/snapshots/.gitkeep
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
# Auto-downloaded YOLO weights (backend/*.pt only - ml/exported/*.pt is a
# deliberately-committed small training artifact, see ml/.gitignore).
/backend/*.pt

# Node / frontend
node_modules/
frontend/dist/
frontend/.env

# Docker Compose overrides (root-level .env, see .env.example)
/.env

# Playwright E2E
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.auth/

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Claude Code local session state
.claude/

# --- Secrets: never commit any real .env, but keep the documented examples ---
.env
.env.local
.env.*.local
!.env.example
!**/.env.example

# --- Python tooling caches ---
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# --- ML artifacts: large, regenerable, and owned by the training pipeline ---
# Auto-downloaded YOLO base weights (repo root). ml/exported/*.pt is a small,
# deliberately-committed deliverable and is NOT matched by this rule.
/*.pt
# Prepared fall-detection dataset (rebuild via ml/detector/prepare_dataset.py)
/ml/data/fall_detection_prepared/
# Detector training runs, checkpoints, logs and dataset sample renders
/ml/runs/
/ml/logs/
/ml/reports/dataset_samples/

# --- Misc ---
*.log
Thumbs.db
