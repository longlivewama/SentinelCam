# Downloaded source datasets - large, re-downloadable via the scripts.
# The prepared train/val/test CSVs (derived, small, reproducible) and the
# exported model + metadata (the actual deliverable) ARE committed.
data/raw_simuletic/
data/raw_coco_pose/
__pycache__/
*.pyc

# Roboflow fall-detection dataset (large, re-downloadable via detector/download_dataset.py)
data/fall_detection/
# Stratified smoke-test subset, regenerated by detector/train.py --smoke.
data/fall_detection_smoke/
# Detector training runs (weights/plots). The SELECTED production artifact
# is promoted into exported/ and committed - along with its metadata
# sidecar, its results.csv and the key curves under reports/fall_detector/
# - so MODEL_CARD.md's numbers are checkable without retraining. The raw
# run directories (checkpoints for every epoch, batch mosaics, ~16MB per
# run) are not.
runs/
# Local secrets (ROBOFLOW_API_KEY) - never commit.
.env

# Video-level validation corpus: real footage of real people falling. Never
# committed - see ml/validation/README.md's privacy section. The annotation
# format and the evaluation code ARE committed; the videos are not.
data/validation/
